# SIGEM Colombia - Variables de Entorno
# Copiar este archivo a .env y configurar valores reales

# ============================================
# CONFIGURACIÓN GENERAL
# ============================================
APP_ENV=development
ENVIRONMENT=development
APP_NAME=SIGEM Colombia
APP_VERSION=1.0.0
DEBUG=true

# ============================================
# BASE DE DATOS
# ============================================
DATABASE_URL=postgresql+asyncpg://sigem:sigem_password@localhost:5433/sigem_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
ALEMBIC_DATABASE_URL=postgresql+asyncpg://sigem:sigem_password@localhost:5433/sigem_db

# ============================================
# REDIS
# ============================================
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=redis_dev_password

# ============================================
# SEGURIDAD
# ============================================
SECRET_KEY=change-this-to-a-random-secret-key-min-32-chars
JWT_SECRET_KEY=change-this-to-another-random-secret-key-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================
# CONTRASEÑAS
# ============================================
PASSWORD_HASH_ALGORITHM=argon2id
PASSWORD_MIN_LENGTH=15
TEMPORARY_PASSWORD_EXPIRY_HOURS=24

# ============================================
# MFA
# ============================================
MFA_ISSUER=SIGEM Colombia
MFA_ENABLED=true

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_REQUESTS=600
RATE_LIMIT_LOGIN_ATTEMPTS=10
RATE_LIMIT_LOGIN_WINDOW_MINUTES=15
RATE_LIMIT_WINDOW=60
TRUST_PROXY_HEADERS=false

# ============================================
# ARCHIVOS / EVIDENCIAS
# ============================================
STORAGE_PATH=/data/evidencias
MAX_UPLOAD_SIZE_MB=50
EVIDENCE_IMAGE_MAX_DIMENSION=2200
EVIDENCE_JPEG_QUALITY=82
EVIDENCE_PDF_IMAGE_QUALITY=78

# ============================================
# URLs (puertos del stack de desarrollo)
# ============================================
FRONTEND_URL=http://localhost:3001
BACKEND_URL=http://localhost:8001

# ============================================
# CORS
# ============================================
CORS_ORIGINS=["http://localhost:3001","http://localhost:3000","http://localhost:5173","http://localhost:5174"]

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=INFO
LOG_FORMAT=json

# ============================================
# MÉTRICAS
# ============================================
METRICS_ENABLED=true
METRICS_TOKEN=

# ============================================
# DOCKER
# ============================================
POSTGRES_USER=sigem
POSTGRES_PASSWORD=sigem_password
POSTGRES_DB=sigem_db

# Notas:
# - METRICS_TOKEN vacío = /metrics sin bearer (solo desarrollo); en producción definir un valor aleatorio.
# - Las URLs y DATABASE_URL de arriba apuntan a los puertos del stack de desarrollo
#   (backend 8001, frontend 3001, PostgreSQL 5433); docker compose los sobreescribe
#   por red interna (postgres:5432, backend:8000).
# - Docker Compose (see infra/docker/.env.example): la interpolación de compose lee
#   infra/docker/.env (gitignored) para POSTGRES_PASSWORD, SIGEM_APP_PASSWORD y REDIS_PASSWORD.
