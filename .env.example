# SIGEM Colombia - Variables de Entorno
# Copiar este archivo a .env y configurar valores reales

# ============================================
# CONFIGURACIÓN GENERAL
# ============================================
APP_ENV=development
APP_NAME=SIGEM Colombia
APP_VERSION=1.0.0
DEBUG=true

# ============================================
# BASE DE DATOS
# ============================================
DATABASE_URL=postgresql+asyncpg://sigem:sigem_password@localhost:5432/sigem_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ============================================
# REDIS
# ============================================
REDIS_URL=redis://localhost:6379/0

# ============================================
# SEGURIDAD
# ============================================
SECRET_KEY=change-this-to-a-random-secret-key-min-32-chars
JWT_SECRET_KEY=change-this-to-another-random-secret-key-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================
# CONTRASEÑAS
# ============================================
PASSWORD_HASH_ALGORITHM=argon2id
PASSWORD_MIN_LENGTH=15
TEMPORARY_PASSWORD_EXPIRY_HOURS=24

# ============================================
# MFA
# ============================================
MFA_ISSUER=SIGEM Colombia
MFA_ENABLED=true

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_MINUTES=15

# ============================================
# ARCHIVOS / EVIDENCIAS
# ============================================
STORAGE_PATH=/data/evidencias
MAX_UPLOAD_SIZE_MB=50

# ============================================
# URLs
# ============================================
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# ============================================
# CORS
# ============================================
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=INFO
LOG_FORMAT=json

# ============================================
# DOCKER
# ============================================
POSTGRES_USER=sigem
POSTGRES_PASSWORD=sigem_password
POSTGRES_DB=sigem_db
