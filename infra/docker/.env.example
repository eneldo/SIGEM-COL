# SIGEM Colombia — Docker secrets template
# Copy this file to .env (same directory) and set real values.
# .env is gitignored; this example file is the only one versioned.
#
# Used by docker-compose.yml for:
#   - postgres superuser password (migrations / alembic)
#   - sigem_app role password (application DATABASE_URL)
#   - redis password
POSTGRES_PASSWORD=replace-with-a-strong-postgres-password
SIGEM_APP_PASSWORD=replace-with-a-strong-app-password
REDIS_PASSWORD=replace-with-a-strong-redis-password
