# SIGEM Colombia - production environment template
#
# Copy this file to infra/docker/.env.prod and replace EVERY CHANGE_ME value
# before the first deploy. The .env.prod file is git-ignored and must never
# be committed or shared.
#
# Generate each secret separately:
#   openssl rand -base64 48
#
# Secrets embedded inside URLs (DATABASE_URL, ALEMBIC_DATABASE_URL,
# REDIS_URL) must be URL-safe. Either generate them with:
#   openssl rand -hex 32
# or URL-encode the base64 value (+ -> %2B, / -> %2F, = -> %3D).
#
# SIGEM_APP_PASSWORD and the password inside DATABASE_URL MUST be the same
# value, otherwise the application cannot connect.

# ============================================================
# APPLICATION
# ============================================================
APP_ENV=production
ENVIRONMENT=production
APP_NAME=SIGEM Colombia
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json

# ============================================================
# POSTGRES (superuser used by migrations/alembic + init scripts)
# ============================================================
POSTGRES_USER=sigem
POSTGRES_DB=sigem_db
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_base64_48

# Password for the non-owner application role created by
# infra/postgres/init/01-app-role.sh (Row-Level Security depends on the
# app connecting as sigem_app, never as sigem).
SIGEM_APP_PASSWORD=CHANGE_ME_openssl_rand_base64_48

# ============================================================
# DATABASE URLS
# ============================================================
# Application connection: non-owner role sigem_app (RLS enforced).
DATABASE_URL=postgresql+asyncpg://sigem_app:CHANGE_ME@postgres:5432/sigem_db

# Migration connection: owner/superuser role sigem (alembic only).
ALEMBIC_DATABASE_URL=postgresql+asyncpg://sigem:CHANGE_ME@postgres:5432/sigem_db

DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

DB_HOST=postgres
DB_PORT=5432

# ============================================================
# REDIS (authentication required in production)
# ============================================================
REDIS_PASSWORD=CHANGE_ME_openssl_rand_base64_48
REDIS_URL=redis://:CHANGE_ME@redis:6379/0

# ============================================================
# SECURITY
# ============================================================
SECRET_KEY=CHANGE_ME_openssl_rand_base64_48
JWT_SECRET_KEY=CHANGE_ME_openssl_rand_base64_48
ENCRYPTION_KEY=CHANGE_ME_openssl_rand_base64_48
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_HASH_ALGORITHM=argon2id
PASSWORD_MIN_LENGTH=15
TEMPORARY_PASSWORD_EXPIRY_HOURS=24
MFA_ISSUER=SIGEM Colombia
MFA_ENABLED=true

# ============================================================
# RATE LIMITING
# ============================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_MINUTES=15

# ============================================================
# STORAGE (evidencias)
# ============================================================
STORAGE_PATH=/data/evidencias
MAX_UPLOAD_SIZE_MB=50

# ============================================================
# URLS / CORS / PROXY
# ============================================================
# Replace CHANGE_ME.example with the real public hostname.
FRONTEND_URL=https://CHANGE_ME.example
BACKEND_URL=https://CHANGE_ME.example
CORS_ORIGINS=["https://CHANGE_ME.example"]
TRUST_PROXY_HEADERS=true

# ============================================================
# BACKUPS (scripts/backup/*, container service `backup`)
# ============================================================
BACKUP_DIR=/backups
BACKUP_TIME=03:00
TZ=America/Bogota
BACKUP_RETENTION_DAYS=14
EVIDENCIAS_DIR=/data/evidencias

# Optional offsite hook. When set (user@host:/srv/sigem/backups), run_backup.sh
# runs rsync after every successful run. Leave empty to disable.
BACKUP_RSYNC_TARGET=

# ============================================================
# OBSERVABILITY
# ============================================================
METRICS_TOKEN=CHANGE_ME_openssl_rand_base64_48
